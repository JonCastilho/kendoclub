# Copie para .env e preencha. Nunca versione o .env.

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/kendoclub?schema=public"

# --- Sessão ---
# Chave de assinatura do cookie de sessão, mínimo 32 caracteres.
# Gere uma com:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=""

# --- Aplicação ---
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Endereço do código-fonte, exibido no rodapé.
# Exigido pelo artigo 13 da AGPL-3.0 para quem publica uma versão modificada.
NUXT_PUBLIC_SOURCE_URL="https://github.com/JonCastilho/kendoclub"

# --- E-mail (redefinição de senha e convites) ---
# Sem SMTP configurado, a diretoria gera o link de redefinição pelo painel.
# O prefixo NUXT_ é o que liga a variável ao runtimeConfig do nuxt.config.ts.
NUXT_SMTP_HOST=""
NUXT_SMTP_PORT="587"
NUXT_SMTP_USER=""
NUXT_SMTP_PASSWORD=""
NUXT_SMTP_FROM="KendoClub <nao-responda@exemplo.org>"

# --- Uploads ---
NUXT_UPLOAD_DIR="./uploads"
