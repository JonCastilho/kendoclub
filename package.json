{
  "name": "kendoclub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Sistema de gestão para clubes de kendo",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "setup": "node --import jiti/register scripts/setup.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "nuxt typecheck",
    "test:unidade": "vitest run --project unidade",
    "test:api": "vitest run --project api"
  },
  "dependencies": {
    "@nuxt/ui": "^3.3.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "nodemailer": "^9.0.5",
    "nuxt": "^3.21.11",
    "nuxt-auth-utils": "^0.5.30",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^7.0.12",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
