// KendoClub — modelo de dados
// Documentação das decisões de modelagem: ../PLANO.md (seção 4)
//
// Convenção: entidades e campos do domínio em português, sem acentos.
// Fica em inglês apenas o que o framework impõe (métodos do Prisma, pastas do
// Nuxt). Os termos de kendo — kyu, dan — permanecem como são ditos.

generator client {
  provider = "prisma-client-js"
}

// A partir do Prisma 7 a URL do banco não fica mais aqui: as migrations leem de
// prisma.config.ts e o client recebe um adapter. Ver ../prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enumerações

enum Papel {
  DIRETORIA
  PRATICANTE
}

/// Existe para inscrição em campeonato, onde as chaves são separadas.
enum Sexo {
  FEMININO
  MASCULINO
}

enum TipoDocumento {
  CPF
  DOCUMENTO_ESTRANGEIRO
}

/// De quem é o documento. Menor sem CPF é cadastrado com o do responsável, e
/// nesse caso o número se repete entre irmãos — por isso a unicidade só vale
/// para PROPRIO, por índice parcial criado na migration.
enum TitularDocumento {
  PROPRIO
  RESPONSAVEL
}

/// Faixa máxima possível. Onde a lista começa em cada modalidade é decidido por
/// Modalidade.kyuInicial — assim mudar a faixa não vira migração de banco.
enum Grau {
  KYU_10
  KYU_9
  KYU_8
  KYU_7
  KYU_6
  KYU_5
  KYU_4
  KYU_3
  KYU_2
  KYU_1
  DAN_1
  DAN_2
  DAN_3
  DAN_4
  DAN_5
  DAN_6
  DAN_7
  DAN_8
}

/// O que a isenção cobre. Existe para que a escolha seja do clube, e não uma
/// decisão implícita no código: "gratuidade" pode significar perdoar tudo ou só
/// a mensalidade, e os dois casos acontecem.
enum AbrangenciaIsencao {
  MENSALIDADE
  ALUGUEL
  TUDO
}

enum TipoLinhaMensalidade {
  MENSALIDADE
  ALUGUEL
  OUTRO
}

/// Quais aluguéis entram na competência. Parametrizável porque cada dojo cobra
/// de um jeito, e a diferença é uma cláusula da consulta — não dois caminhos de
/// cobrança. Ver PLANO.md, regras da geração.
enum RegraCobrancaAluguel {
  /// Só o que já existia no primeiro dia do mês: quem retira dia 20 paga a
  /// partir do mês seguinte, e quem devolve dentro do mesmo mês não paga.
  ABERTO_NO_PRIMEIRO_DIA
  /// Todo aluguel que existiu em algum dia do mês.
  ABERTO_EM_QUALQUER_DIA
}

enum SituacaoMensalidade {
  ABERTA
  PAGA
  ISENTA
  CANCELADA
}

enum Visibilidade {
  PUBLICA
  RESTRITA // somente quem está logado
}

/// Estado administrativo do item. "Alugado" não entra aqui de propósito: isso é
/// consequência de existir aluguel em aberto, e um campo separado acabaria
/// discordando da realidade — o mesmo motivo pelo qual o praticante não tem
/// campo de situação.
enum SituacaoItem {
  DISPONIVEL
  MANUTENCAO
  BAIXADO
}

enum SituacaoConfirmacao {
  VOU
  NAO_VOU
  TALVEZ
}

// -------------------------------------------------------------------- acesso

model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(PRATICANTE)
  ativo         Boolean   @default(true)
  ultimoAcessoEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  /// Conta de acesso ligada a um praticante. Quem é da diretoria pode não ser
  /// praticante, e praticante menor de idade pode não ter conta.
  praticante   Praticante? @relation(fields: [praticanteId], references: [id], onDelete: SetNull)
  praticanteId String?     @unique

  publicacoes         Publicacao[]           @relation("AutorPublicacao")
  eventosCriados      Evento[]               @relation("CriadorEvento")
  mensalidadesBaixadas Mensalidade[]         @relation("BaixadaPor")
  isencoesConcedidas  Isencao[]              @relation("IsencaoConcedidaPor")
  tokensRedefinicao   TokenRedefinicaoSenha[]

  @@index([papel])
}

model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@index([usuarioId])
}

// --------------------------------------------------------------- praticantes

model Praticante {
  id             String   @id @default(cuid())
  nomeCompleto   String
  dataNascimento DateTime
  sexo           Sexo
  nacionalidade  String   @default("Brasileira")
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  /// Documento, e não "CPF": aceita também documento estrangeiro. A conferência
  /// dos dígitos verificadores só roda quando tipoDocumento é CPF. CPF é
  /// guardado apenas com os números.
  documento        String
  tipoDocumento    TipoDocumento    @default(CPF)
  titularDocumento TitularDocumento @default(PROPRIO)

  // Contato. Este e-mail é de contato e pode repetir entre irmãos; o e-mail
  // único é o da conta de acesso, em Usuario.
  email                String
  telefone             String
  telefoneAlternativo  String?

  // Endereço decomposto, para servir de correspondência.
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  /// Contato de emergência. Par natural das observações médicas: é o que serve
  /// na hora do problema, no dojo.
  emergenciaNome       String?
  emergenciaTelefone   String?
  emergenciaParentesco String?

  /// Responsável, para praticantes menores de idade.
  responsavelNome     String?
  responsavelTelefone String?

  /// DADO SENSÍVEL (LGPD art. 5º, II). Nunca sai em listagem nem em exportação,
  /// e só a diretoria enxerga. Ver PLANO.md §11.
  observacoesMedicas String?

  iniciouPraticaEm DateTime?
  observacoes      String?

  // Consentimentos, cada um com sua data de aceite.
  consentimentoDadosEm       DateTime?
  consentimentoSaudeEm       DateTime?
  autorizacaoImagemEm        DateTime?
  responsavelConsentimentoEm DateTime?

  usuario      Usuario?
  filiacoes    Filiacao[]
  modalidades  PraticanteModalidade[]
  isencoes     Isencao[]
  alugueis     Aluguel[]
  mensalidades Mensalidade[]
  confirmacoes ConfirmacaoPresenca[]

  @@index([nomeCompleto])
  @@index([documento])
}

/// Período de vínculo com o clube. Quem se desliga e volta ganha uma linha nova,
/// e o tempo de casa anterior fica preservado. A situação atual é derivada:
/// filiação em aberto significa filiado.
///
/// A migration cria um índice parcial garantindo no máximo uma filiação aberta
/// por praticante — regra que o banco sustenta, não só a tela.
model Filiacao {
  id         String    @id @default(cuid())
  inicioEm   DateTime
  fimEm      DateTime?
  motivoSaida String?
  criadoEm   DateTime  @default(now())

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String

  @@index([praticanteId, inicioEm])
}

model Modalidade {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativa Boolean @default(true)

  /// Kyu mais alto usado nesta modalidade (6 significa "começa no 6º kyu").
  /// Kendo costuma começar no 6º; iaido, no 5º.
  kyuInicial Int @default(6)

  criadoEm DateTime @default(now())

  praticantes PraticanteModalidade[]
}

/// O que o praticante faz, e em que grau está.
///
/// A graduação vive aqui, e não numa tabela de histórico: o clube registra o
/// grau atual, e o anterior é substituído. Para exame de graduação o que importa
/// é o grau vigente e desde quando — que é exatamente o que fica guardado.
model PraticanteModalidade {
  id    String    @id @default(cuid())
  desde DateTime
  ate   DateTime?

  /// Nulo é mukyu — literalmente "sem grau", como todo praticante começa.
  grau                 Grau?
  graduadoEm           DateTime?
  observacoesGraduacao String?

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Restrict)
  modalidadeId String

  @@unique([praticanteId, modalidadeId])
}

/// Gratuidade de mensalidade. Tem vigência, motivo e responsável porque mexe em
/// dinheiro — o mês de quem tem isenção vigente gera mensalidade ISENTA, e não
/// ausência de cobrança.
model Isencao {
  id          String            @id @default(cuid())
  inicioEm    DateTime
  fimEm       DateTime?
  motivo      String
  abrangencia AbrangenciaIsencao @default(TUDO)
  criadoEm    DateTime          @default(now())

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String

  concedidaPor       Usuario? @relation("IsencaoConcedidaPor", fields: [concedidaPorUsuarioId], references: [id], onDelete: SetNull)
  concedidaPorUsuarioId String?

  @@index([praticanteId, inicioEm])
}

// ------------------------------------------------------------ itens alugáveis

/// Equipamento do clube emprestado a praticantes — bogu, principalmente.
model Item {
  id            String       @id @default(cuid())
  nome          String
  /// Número de patrimônio ou etiqueta, para diferenciar dois bogus iguais.
  identificador String?
  tipo          String?
  situacao      SituacaoItem @default(DISPONIVEL)
  observacoes   String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  /// Valor mensal cobrado pelo aluguel. Cada aluguel copia este valor no
  /// momento da contratação, então reajuste não reescreve o que já foi cobrado.
  valorMensalAluguel Decimal @default(0) @db.Decimal(10, 2)

  alugueis Aluguel[]

  @@index([situacao])
  @@index([nome])
}

/// Período em que um item esteve com um praticante.
///
/// A migration cria um índice parcial garantindo um único aluguel aberto por
/// item: sem isso, o mesmo bogu poderia constar com duas pessoas ao mesmo tempo,
/// e a mensalidade cobraria os dois.
model Aluguel {
  id         String    @id @default(cuid())
  inicioEm   DateTime
  fimEm      DateTime?
  observacao String?
  criadoEm   DateTime  @default(now())

  /// Valor vigente na contratação. Ver comentário em Item.valorMensalAluguel.
  valorMensal Decimal @db.Decimal(10, 2)

  /// O que está alugado, em texto livre — "Bogu", "Kote", "Men".
  ///
  /// Existe porque nem todo dojo controla patrimônio: o clube que só quer somar
  /// a taxa de aluguel na mensalidade registra a descrição e não cadastra item
  /// nenhum. Quem controla vincula o item e ganha o "quem está com o quê" por
  /// cima do mesmo registro. Um caminho de código só, com ou sem inventário.
  descricao String?

  item         Item?      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId       String?
  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Restrict)
  praticanteId String

  linhasDeMensalidade LinhaMensalidade[]

  @@index([itemId, inicioEm])
  @@index([praticanteId])
}

// -------------------------------------------------------------- mensalidades

model Mensalidade {
  id String @id @default(cuid())
  /// Competência no formato AAAA-MM.
  competencia String
  /// Soma das linhas, guardada para não precisar recalcular a cada listagem.
  /// Cada linha carrega o valor aplicado na geração, então reajuste de
  /// mensalidade ou de aluguel não reescreve o passado.
  valorTotal     Decimal             @db.Decimal(10, 2)
  vencimento     DateTime
  situacao       SituacaoMensalidade @default(ABERTA)
  pagaEm         DateTime?
  valorPago      Decimal?            @db.Decimal(10, 2)
  formaPagamento String?
  observacao     String?
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Restrict)
  praticanteId String

  linhas LinhaMensalidade[]

  /// Quem deu a baixa. Dinheiro pede trilha — PLANO.md §11.
  baixadaPor          Usuario? @relation("BaixadaPor", fields: [baixadaPorUsuarioId], references: [id], onDelete: SetNull)
  baixadaPorUsuarioId String?

  /// Impede gerar a mesma competência duas vezes para o mesmo praticante.
  @@unique([praticanteId, competencia])
  @@index([situacao, vencimento])
  @@index([competencia])
}

/// Cada parcela do que se cobra no mês: a mensalidade do clube e um aluguel por
/// item ou peça. Existe para o praticante enxergar de que se compõe o valor —
/// e para taxa de exame ou camiseta entrarem depois sem mudar o modelo.
model LinhaMensalidade {
  id        String               @id @default(cuid())
  tipo      TipoLinhaMensalidade
  descricao String
  valor     Decimal              @db.Decimal(10, 2)

  mensalidade   Mensalidade @relation(fields: [mensalidadeId], references: [id], onDelete: Cascade)
  mensalidadeId String

  /// De qual aluguel veio a linha, quando veio de um. Serve para explicar a
  /// cobrança depois, mesmo que o aluguel já tenha sido devolvido.
  aluguel   Aluguel? @relation(fields: [aluguelId], references: [id], onDelete: SetNull)
  aluguelId String?

  @@index([mensalidadeId])
}

// ------------------------------------------------------------------ conteúdo

model Publicacao {
  id           String       @id @default(cuid())
  titulo       String
  slug         String       @unique
  conteudo     String // markdown
  imagemCapa   String?
  visibilidade Visibilidade @default(PUBLICA)
  publicadaEm  DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  autor          Usuario @relation("AutorPublicacao", fields: [autorUsuarioId], references: [id], onDelete: Restrict)
  autorUsuarioId String

  @@index([visibilidade, publicadaEm])
}

model Evento {
  id                String       @id @default(cuid())
  titulo            String
  slug              String       @unique
  descricao         String // markdown
  local             String?
  inicioEm          DateTime
  fimEm             DateTime?
  visibilidade      Visibilidade @default(PUBLICA)
  prazoConfirmacao  DateTime?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  criadoPor          Usuario @relation("CriadorEvento", fields: [criadoPorUsuarioId], references: [id], onDelete: Restrict)
  criadoPorUsuarioId String

  confirmacoes ConfirmacaoPresenca[]

  @@index([inicioEm])
  @@index([visibilidade, inicioEm])
}

/// Confirmação de presença em evento. Não confundir com o controle de presença
/// nos treinos, previsto para depois do MVP.
model ConfirmacaoPresenca {
  id           String              @id @default(cuid())
  situacao     SituacaoConfirmacao
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  evento       Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  eventoId     String
  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String

  @@unique([eventoId, praticanteId])
  @@index([eventoId, situacao])
}

// --------------------------------------------------------------- configuração

/// Linha única (id = 1). É o que cada clube personaliza ao instalar.
model ConfiguracaoClube {
  id            Int      @id @default(1)
  nomeClube     String   @default("Clube de Kendo")
  logo          String?
  emailContato  String?
  chavePix      String?
  titularPix    String?

  /// Mensalidade do clube: valor único para todos. Cada mensalidade gerada
  /// guarda o valor aplicado, então reajuste não reescreve o passado.
  valorMensalidade Decimal @default(0) @db.Decimal(10, 2)
  diaVencimento    Int     @default(10)

  /// Valor sugerido ao registrar um aluguel, para o clube que cobra uma taxa
  /// única de bogu. Cada aluguel guarda o valor aplicado.
  valorAluguelPadrao Decimal @default(0) @db.Decimal(10, 2)

  regraCobrancaAluguel RegraCobrancaAluguel @default(ABERTO_NO_PRIMEIRO_DIA)
  corPrimaria   String   @default("#1e3a8a")
  fusoHorario   String   @default("America/Sao_Paulo")
  atualizadoEm  DateTime @updatedAt
}
