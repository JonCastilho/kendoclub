// KendoClub — modelo de dados
// Documentação das decisões de modelagem: ../PLANO.md (seção 4)
//
// Convenção: entidades e campos do domínio em português, sem acentos.
// Fica em inglês apenas o que o framework impõe (métodos do Prisma, pastas do
// Nuxt). Os termos de kendo — kyu, dan — permanecem como são ditos.

generator client {
  provider = "prisma-client-js"
}

// A partir do Prisma 7 a URL do banco não fica mais aqui: as migrations leem de
// prisma.config.ts e o client recebe um adapter. Ver ../prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enumerações

enum Papel {
  DIRETORIA
  PRATICANTE
}

enum SituacaoPraticante {
  ATIVO
  AFASTADO
  DESLIGADO
}

/// Graduações. Clubes com turma infantil costumam usar kyu acima do 6º.
enum Grau {
  KYU_8
  KYU_7
  KYU_6
  KYU_5
  KYU_4
  KYU_3
  KYU_2
  KYU_1
  DAN_1
  DAN_2
  DAN_3
  DAN_4
  DAN_5
  DAN_6
  DAN_7
  DAN_8
}

enum SituacaoMensalidade {
  ABERTA
  PAGA
  ISENTA
  CANCELADA
}

enum Visibilidade {
  PUBLICA
  RESTRITA // somente quem está logado
}

enum SituacaoConfirmacao {
  VOU
  NAO_VOU
  TALVEZ
}

// -------------------------------------------------------------------- acesso

model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(PRATICANTE)
  ativo         Boolean   @default(true)
  ultimoAcessoEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  /// Conta de acesso ligada a um praticante. Quem é da diretoria pode não ser
  /// praticante, e praticante menor de idade pode não ter conta.
  praticante   Praticante? @relation(fields: [praticanteId], references: [id], onDelete: SetNull)
  praticanteId String?     @unique

  publicacoes         Publicacao[]           @relation("AutorPublicacao")
  eventosCriados      Evento[]               @relation("CriadorEvento")
  mensalidadesBaixadas Mensalidade[]         @relation("BaixadaPor")
  tokensRedefinicao   TokenRedefinicaoSenha[]

  @@index([papel])
}

model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@index([usuarioId])
}

// --------------------------------------------------------------- praticantes

model Praticante {
  id             String             @id @default(cuid())
  nomeCompleto   String
  dataNascimento DateTime?
  telefone       String?
  email          String?
  endereco       String?
  situacao       SituacaoPraticante @default(ATIVO)
  ingressouEm    DateTime           @default(now())
  desligadoEm    DateTime?
  observacoes    String?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt

  /// Responsável, para praticantes menores de idade.
  responsavelNome     String?
  responsavelTelefone String?
  /// Quando o responsável autorizou o tratamento dos dados (LGPD).
  responsavelConsentimentoEm DateTime?

  /// Mensalidade vigente. O histórico fica em Mensalidade.valor — PLANO.md §4.
  valorMensalidade Decimal @default(0) @db.Decimal(10, 2)

  usuario      Usuario?
  graduacoes   Graduacao[]
  mensalidades Mensalidade[]
  confirmacoes ConfirmacaoPresenca[]

  @@index([situacao])
  @@index([nomeCompleto])
}

model Graduacao {
  id          String   @id @default(cuid())
  grau        Grau
  obtidaEm    DateTime
  observacoes String?
  criadoEm    DateTime @default(now())

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String

  @@index([praticanteId, obtidaEm])
}

// -------------------------------------------------------------- mensalidades

model Mensalidade {
  id String @id @default(cuid())
  /// Competência no formato AAAA-MM.
  competencia String
  /// Valor cobrado na geração — não deriva de Praticante.valorMensalidade.
  valor          Decimal             @db.Decimal(10, 2)
  vencimento     DateTime
  situacao       SituacaoMensalidade @default(ABERTA)
  pagaEm         DateTime?
  valorPago      Decimal?            @db.Decimal(10, 2)
  formaPagamento String?
  observacao     String?
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt

  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Restrict)
  praticanteId String

  /// Quem deu a baixa. Dinheiro pede trilha — PLANO.md §11.
  baixadaPor          Usuario? @relation("BaixadaPor", fields: [baixadaPorUsuarioId], references: [id], onDelete: SetNull)
  baixadaPorUsuarioId String?

  /// Impede gerar a mesma competência duas vezes para o mesmo praticante.
  @@unique([praticanteId, competencia])
  @@index([situacao, vencimento])
  @@index([competencia])
}

// ------------------------------------------------------------------ conteúdo

model Publicacao {
  id           String       @id @default(cuid())
  titulo       String
  slug         String       @unique
  conteudo     String // markdown
  imagemCapa   String?
  visibilidade Visibilidade @default(PUBLICA)
  publicadaEm  DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  autor          Usuario @relation("AutorPublicacao", fields: [autorUsuarioId], references: [id], onDelete: Restrict)
  autorUsuarioId String

  @@index([visibilidade, publicadaEm])
}

model Evento {
  id                String       @id @default(cuid())
  titulo            String
  slug              String       @unique
  descricao         String // markdown
  local             String?
  inicioEm          DateTime
  fimEm             DateTime?
  visibilidade      Visibilidade @default(PUBLICA)
  prazoConfirmacao  DateTime?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  criadoPor          Usuario @relation("CriadorEvento", fields: [criadoPorUsuarioId], references: [id], onDelete: Restrict)
  criadoPorUsuarioId String

  confirmacoes ConfirmacaoPresenca[]

  @@index([inicioEm])
  @@index([visibilidade, inicioEm])
}

/// Confirmação de presença em evento. Não confundir com o controle de presença
/// nos treinos, previsto para depois do MVP.
model ConfirmacaoPresenca {
  id           String              @id @default(cuid())
  situacao     SituacaoConfirmacao
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  evento       Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  eventoId     String
  praticante   Praticante @relation(fields: [praticanteId], references: [id], onDelete: Cascade)
  praticanteId String

  @@unique([eventoId, praticanteId])
  @@index([eventoId, situacao])
}

// --------------------------------------------------------------- configuração

/// Linha única (id = 1). É o que cada clube personaliza ao instalar.
model ConfiguracaoClube {
  id            Int      @id @default(1)
  nomeClube     String   @default("Clube de Kendo")
  logo          String?
  emailContato  String?
  chavePix      String?
  titularPix    String?
  corPrimaria   String   @default("#1e3a8a")
  fusoHorario   String   @default("America/Sao_Paulo")
  atualizadoEm  DateTime @updatedAt
}
