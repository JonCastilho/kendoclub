# O npm 10 (o que acompanha o Node 20) quebra ao montar o conjunto de peer
# dependencies do nuxt: "Cannot read properties of null (reading 'edgesOut')".
# É um bug do npm, não um conflito real do projeto.
# Pode ser removido quando o projeto passar a exigir Node 22+, que traz o npm 11.
legacy-peer-deps=true
